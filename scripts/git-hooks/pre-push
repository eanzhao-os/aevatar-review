#!/usr/bin/env bash
# Validate the active book before push. Missing local rendering dependencies are
# reported explicitly; CI remains the fail-closed authority for those tools.
set -uo pipefail

if [ "${SKIP_DOCS_CHECK:-0}" = "1" ]; then
  echo "pre-push: SKIP_DOCS_CHECK=1, skipping documentation validation." >&2
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root" || { echo "pre-push: cannot enter repository root" >&2; exit 1; }
sha=f02aa690bbebb9cabeac30a553d737486b0eb661
upstream_repo="${AEVATAR_UPSTREAM_REPO:-$HOME/Code/aevatar}"
limited=0

if [ -d "$upstream_repo/.git" ]; then
  if ! AEVATAR_SRC="$(bash scripts/materialize-frozen-upstream.sh --repo "$upstream_repo" --sha "$sha")"; then
    echo "pre-push: unable to materialize frozen upstream $sha" >&2
    exit 1
  fi
  export AEVATAR_SRC
  AEVATAR_SRC="$AEVATAR_SRC" bash scripts/check-md.sh --all || exit 1
else
  echo "pre-push: environment limitation — frozen upstream repository not found at $upstream_repo" >&2
  limited=1
fi

python3 scripts/check-links.py --all || exit 1
bash scripts/check-drift.sh || exit 1

if command -v mmdc >/dev/null 2>&1 || command -v npx >/dev/null 2>&1; then
  python3 scripts/check-mermaid.py || exit 1
else
  echo "pre-push: environment limitation — mermaid-cli/npx unavailable" >&2
  limited=1
fi

if command -v mkdocs >/dev/null 2>&1; then
  MKDOCS=(mkdocs)
elif python3 -c "import mkdocs" >/dev/null 2>&1; then
  MKDOCS=(python3 -m mkdocs)
else
  echo "pre-push: environment limitation — MkDocs unavailable" >&2
  limited=1
  MKDOCS=()
fi

if [ "${#MKDOCS[@]}" -gt 0 ]; then
  tmp_site="$(mktemp -d)"
  trap 'rm -rf "$tmp_site"' EXIT
  "${MKDOCS[@]}" build --strict --clean --site-dir "$tmp_site" || exit 1
  python3 scripts/check-site-ui.py --site-dir "$tmp_site" || exit 1
fi

if [ "$limited" -eq 1 ]; then
  echo "pre-push: completed available checks; CI will fail closed on missing dependencies" >&2
else
  echo "pre-push: all documentation checks passed" >&2
fi
